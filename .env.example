# Variable names deliberately avoid a leading digit — shells and Docker
# Compose can't interpolate a name starting with a number.

# Host port to publish the app on
PPRACTICE_PORT=3000

# Where the container's SQLite data lives on the host
PPRACTICE_APP_DATA_DIR=/home/user/docker/appdata/1ppractice

# Long random string — generate with: openssl rand -hex 32
PPRACTICE_SESSION_SECRET=

# LAN IP Traefik should reach this container on (matches whatever host
# PPRACTICE_PORT above is published on)
PPRACTICE_SERVER_IP=

# You likely already have these set globally for your other services —
# only add them here if this compose file is standalone.
# PUID=1000
# PGID=1000
# DOMAINNAME_1=yourdomain.com

# Optional — only needed for Lesson 4 ("connect a Google login"). Without
# these, that lesson shows setup instructions instead of a working button.
# Create an OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials (type: Web application)
# with an authorized redirect URI of https://<your-domain>/account/google/callback
PPRACTICE_GOOGLE_CLIENT_ID=
PPRACTICE_GOOGLE_CLIENT_SECRET=
