<%- include('partials/head', { title: 'Create a dummy account' }) %>

<div class="card card-narrow">
  <%- include('partials/lesson-splash', { lesson: typeof lesson !== 'undefined' ? lesson : null, lessonSteps: `
    <ol>
      <li>Pick any username — it doesn't need to be real.</li>
      <li>Click into the password field. 1Password should offer to suggest a
        strong password right there instead of you making one up.</li>
      <li>Submit the form, then look for 1Password's "Save Login" prompt and
        confirm it.</li>
    </ol>
  ` }) %>
  <% if (typeof lesson === 'undefined' || !lesson) { %><h1>Create a dummy account</h1><% } %>
  <%- include('partials/flash') %>
  <form method="POST" action="/signup" autocomplete="on">
    <label for="username">Username</label>
    <input id="username" name="username" type="text" autocomplete="username" required autofocus>

    <label for="password">Password</label>
    <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8">

    <button class="btn btn-primary" type="submit">Create account</button>
  </form>
  <p><a href="/login">Already have a practice account? Log in</a></p>
</div>

<%- include('partials/foot') %>
